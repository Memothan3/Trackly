# Trackly Vite app — copy to .env and adjust as needed
VITE_APP_NAME=Trackly
VITE_DEFAULT_CURRENCY=USD
VITE_LEGACY_APP_URL=same

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.region.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Apple Sign In (Apple Developer → Services ID → Return URLs):
# https://<your-project-id>.firebaseapp.com/__/auth/handler
# Production example: https://rubys-3ca51.firebaseapp.com/__/auth/handler
# Also add domain: <your-project-id>.firebaseapp.com
# Firebase Console → Auth → Apple: Service ID, Team ID, Key ID, .p8 key
